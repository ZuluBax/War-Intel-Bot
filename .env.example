# ---------------------------------------------------------------------------
# Torn War Intelligence Bot — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# The bot is MULTI-SERVER. You invite it to any Discord server with its OAuth2
# link, and each server configures its own Torn faction + API key with the
# in-Discord `/setup` command. So the only things needed here are the bot token
# and the encryption key used to protect those per-server API keys at rest.
# ---------------------------------------------------------------------------

# --- Required ------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# urlsafe-base64 32-byte Fernet key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, the bot generates config/secret.key on first run and uses that
# (back it up — losing it means every server must re-run /setup).
CONFIG_ENCRYPTION_KEY=
# If this key changes, the bot refuses to start (crypto.key_mismatch) rather than
# silently stopping every server. Emergency only, when the original key is LOST
# for good: set this to true for ONE start to clear the unreadable saved API keys
# (each server then re-runs /setup torn-key), then remove it.
# RESET_UNREADABLE_KEYS=true

# --- Optional ----------------------------------------------------------------
# A "home"/dev server ID for INSTANT slash-command sync while developing.
# Commands also sync globally (up to ~1h to appear) and instantly per server on
# join, so this is only a convenience.
DISCORD_DEV_GUILD_ID=

# Fallback FFScouter key used for a server that hasn't set its own via
# `/setup ffscouter-key`. Optional.
FFSCOUTER_API_KEY=

# Local-dev only: an operator Torn key + faction id, used by scripts/probe_torn.py
# and ignored in normal multi-server operation.
TORN_API_KEY=
TORN_FACTION_ID=

# --- Database ------------------------------------------------------------
# Local/dev default is SQLite. Production should use PostgreSQL, e.g.:
#   postgresql+asyncpg://user:password@postgres:5432/torn_war_intel
DATABASE_URL=sqlite+aiosqlite:///./data/torn_war_intelligence.db

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# "console" for human-readable dev output, "json" for structured production logs.
LOG_FORMAT=console

# --- Scheduling / refresh intervals (seconds) ------------------------------
WAR_CHECK_INTERVAL_SECONDS=60
WAR_CHECK_INTERVAL_FAST_SECONDS=15
STATUS_REFRESH_INTERVAL_SECONDS=15
STATS_REFRESH_INTERVAL_SECONDS=900

# --- Behaviour toggles -----------------------------------------------------
# When true, the war-detection job is not scheduled. Never enable in production.
MOCK_API=false
