# Keep the build context small and free of secrets / local state.
.git
.gitignore
.github
.venv
venv
__pycache__
*.pyc
.mypy_cache
.ruff_cache
.pytest_cache
.claude
.claude-flow

# Secrets and local data — never bake these into the image
.env
.env.*
!.env.example
config/secret.key
config/*.key
data/
*.db
*.sqlite*
logs/

# Dev-only
tests/
scripts/
docs/
*.md
!README.md
